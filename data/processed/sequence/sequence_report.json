      "features": "train.npz"
    },
    "dev": {
      "records": 1400,
      "truncation_rate": 0.0064285714285714285,
      "features": "dev.npz"
    },
    "test_seen": {
      "records": 1000,
      "truncation_rate": 0.007,
      "features": "test_seen.npz"
    },
    "test_unseen": {
      "records": 1200,
      "truncation_rate": 0.0,
      "features": "test_unseen.npz"
    }
  },
  "embeddings": null
}
